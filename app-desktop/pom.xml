<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.anhtuan.dict</groupId>
    <artifactId>offline-translate-vi-en</artifactId>
    <version>1.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>app-desktop</artifactId>
  <name>app-desktop</name>
  <description>JavaFX desktop UI.</description>

  <dependencies>
    <dependency>
      <groupId>com.anhtuan.dict</groupId>
      <artifactId>dict-core</artifactId>
    </dependency>

    <!-- Chỉ javafx-controls. Tuyệt đối không thêm javafx-web: nó kéo theo WebKit (+35 MB đĩa, +40 MB RAM).
         Kiểm tra: mvn -pl app-desktop dependency:tree | grep javafx -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Dịch bằng mô hình nơ-ron. optional: cần để biên dịch nhưng không tự đi theo khi đóng gói.
         Muốn bản có AI thì chạy package.ps1 -WithNmt; không thì app vẫn chạy và tự ẩn tính năng. -->
    <dependency>
      <groupId>com.anhtuan.dict</groupId>
      <artifactId>nmt-engine</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <properties>
    <!-- Loại bản phát hành: "standard" hoặc "ai". Bộ đóng gói ghi đè bằng -Ddict.edition=ai -->
    <dict.edition>standard</dict.edition>
  </properties>

  <build>
    <resources>
      <!-- Lọc version.properties để app biết mình là phiên bản nào, bản nào -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>version.properties</include></includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>version.properties</exclude></excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.anhtuan.dict.desktop.DictApp</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
