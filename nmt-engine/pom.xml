  <artifactId>nmt-engine</artifactId>
  <name>nmt-engine</name>
  <description>
    Dich may no-ron chay cuc bo: opus-mt-en-vi xuat sang ONNX, chay bang ONNX Runtime.

    DAY LA MODULE TUY CHON. Ung dung chay binh thuong khi khong co no - luc do dung engine
    dich bang luat. Tach rieng ra de dict-core giu duoc zero dependency (PLAN.md muc 9) va de
    ai khong muon dinh den mo hinh AI thi chi viec khong build module nay.

    Mo hinh KHONG nam trong repo: tai rieng bang scripts/tai-model-nmt.ps1 (~101 MB).
  </description>

  <dependencies>
    <dependency>
      <groupId>com.anhtuan.dict</groupId>
      <artifactId>dict-core</artifactId>
    </dependency>

    <!-- Chay do thi ONNX. Ban chinh thuc cua Microsoft, co binding Java. -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>${onnxruntime.version}</version>
    </dependency>

    <!-- KHONG dung ai.djl.huggingface:tokenizers. Da thu: no lam sup ca JVM khi doc
         tokenizer.json cua model nay (precompiled_charsmap = null). Tach tu duoc viet lai
         trong MarianTokenizer.java, chua toi 150 dong va khong can thu vien native. -->
  </dependencies>
</project>
