<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.anhtuan.dict</groupId>
    <artifactId>offline-translate-vi-en</artifactId>
    <version>1.1.0</version>
  </parent>

  <artifactId>nmt-engine</artifactId>
  <name>nmt-engine</name>
  <description>Optional local neural translation: opus-mt-en-vi exported to ONNX, run with ONNX Runtime.</description>

  <!-- Module tuỳ chọn: thiếu nó app vẫn chạy bằng engine dịch theo luật. Tách riêng để dict-core
       không có dependency. Mô hình (~101 MB) không nằm trong repo, tải bằng scripts/download-nmt-model.ps1. -->

  <dependencies>
    <dependency>
      <groupId>com.anhtuan.dict</groupId>
      <artifactId>dict-core</artifactId>
    </dependency>

    <!-- Chạy đồ thị ONNX, bản chính thức của Microsoft có binding Java -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>${onnxruntime.version}</version>
    </dependency>

    <!-- Không dùng ai.djl.huggingface:tokenizers: nó làm sập cả JVM khi đọc tokenizer.json của mô hình
         này (precompiled_charsmap = null). Bộ tách từ được viết lại trong MarianTokenizer.java. -->
  </dependencies>
</project>
